# LATTICE environment variables (all optional).
# Copy to `.env` for local development. None are required to run the app, and
# LATTICE enables no telemetry or network AI providers by default.
#
# Every variable below is read by the current source. Variables that are not
# listed here are not honored.

# --- Vault location ---------------------------------------------------------
# Default vault path used on first launch (overrides ~/Documents/Lattice Vault).
# Read by: apps/desktop/src-tauri/src/state.rs (default_vault_path).
LATTICE_VAULT_PATH=

# Advanced overrides for vault/workspace root resolution, used by tooling/tests.
# Leave unset for normal use.
LATTICE_VAULT_ROOT=
LATTICE_WORKSPACE_ROOT=

# --- AI / automation --------------------------------------------------------
# Policy gate for local CLI automation: prompt | allow | deny.
LATTICE_AUTOMATION_POLICY=prompt

# Default model for the Ollama provider in the AI console. The Ollama endpoint
# is currently fixed at http://127.0.0.1:11434 (see crates/lattice-ai/src/ollama.rs).
OLLAMA_MODEL=
